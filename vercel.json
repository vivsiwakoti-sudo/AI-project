{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "functions": {
        "index.js": {
          "includeFiles": "Software Planning (1).docx"
        }
      }
    },
    "orbitalclash": {
      "root": "Orbital Clash",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "orbitalclash"
      }
    }
  ]
}